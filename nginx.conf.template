server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Proxy API calls to the backend service in the same namespace.
  # ${BACKEND_URL} is substituted at container start (nginx image envsubst templates).
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location /healthz {
    access_log off;
    return 200 "ok\n";
  }
}
